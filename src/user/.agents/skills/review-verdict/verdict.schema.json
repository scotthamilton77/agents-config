{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agents.local/schemas/review-verdict/1",
  "title": "Review verdict",
  "description": "Typed result of one code-review round, keyed to the git head SHA it reviewed.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_class",
    "round",
    "base_sha",
    "head_sha",
    "claim_id",
    "retained_categories",
    "lenses",
    "prior_dispositions",
    "verdict",
    "findings"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "artifact_class": {
      "type": "string",
      "pattern": "\\S",
      "description": "What kind of change was reviewed; selects the lens set the round must cover."
    },
    "round": {
      "type": "integer",
      "minimum": 1
    },
    "base_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$",
      "description": "Full git object id the diff was taken against."
    },
    "head_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$",
      "description": "Full git object id of the reviewed head; the verdict is valid only for this commit."
    },
    "claim_id": {
      "type": "string",
      "pattern": "\\S",
      "description": "Identifier of the completion claim this round adjudicates."
    },
    "retained_categories": {
      "type": "array",
      "items": {"type": "string", "pattern": "\\S"},
      "description": "Categories carried forward from earlier rounds; an empty array means nothing retained."
    },
    "lenses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["lens", "verdict"],
        "properties": {
          "lens": {"type": "string", "pattern": "\\S"},
          "verdict": {"enum": ["clean", "findings"]}
        }
      },
      "description": "Every lens the artifact class declares, reported individually, green ones included."
    },
    "prior_dispositions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["round", "id", "disposition"],
        "properties": {
          "round": {"type": "integer", "minimum": 1},
          "id": {"type": "string", "pattern": "\\S"},
          "disposition": {"enum": ["fixed", "rebutted", "advisory-deferred"]},
          "evidence": {"type": "string"}
        },
        "allOf": [
          {
            "if": {"properties": {"disposition": {"const": "rebutted"}}, "required": ["disposition"]},
            "then": {
              "required": ["evidence"],
              "properties": {"evidence": {"type": "string", "pattern": "\\S"}}
            }
          }
        ]
      },
      "description": "One entry per mechanical finding from every prior round's posted verdict."
    },
    "verdict": {"enum": ["clean", "findings"]},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "lens", "type", "ac", "claim"],
        "properties": {
          "id": {"type": "string", "pattern": "\\S"},
          "lens": {"type": "string", "pattern": "\\S"},
          "type": {"enum": ["mechanical", "advisory"]},
          "ac": {"type": "string", "pattern": "\\S"},
          "claim": {"type": "string", "pattern": "\\S"},
          "evidence": {"type": "string"}
        },
        "allOf": [
          {
            "if": {"properties": {"type": {"const": "mechanical"}}, "required": ["type"]},
            "then": {
              "required": ["evidence"],
              "properties": {"evidence": {"type": "string", "pattern": "\\S"}}
            }
          }
        ]
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"verdict": {"const": "findings"}}, "required": ["verdict"]},
      "then": {"properties": {"findings": {"minItems": 1}}}
    },
    {
      "if": {"properties": {"verdict": {"const": "clean"}}, "required": ["verdict"]},
      "then": {"properties": {"findings": {"maxItems": 0}}}
    }
  ]
}
