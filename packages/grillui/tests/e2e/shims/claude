#!/usr/bin/env python3
"""A scripted `claude` on the backend's PATH: the expert seat, and its chain.

It prints the one JSON object `claude -p --output-format json` prints -- the
reply, the chain's identity, and the usage block whose three input-side counts
are summed into what the turn was given. The chain's identity is the point of
asking for structured output at all: without it the next turn has no way to
continue this conversation rather than open a new one.

Like the other shim, it states the driver's contract a second time rather than
importing it, and records a violation instead of exiting on one.
"""

from __future__ import annotations

import json
import os
import sys
from pathlib import Path
from typing import Any

sys.path.insert(0, str(Path(__file__).resolve().parent))

from _shim import emit, flag_value, record, stdin_is_closed, turns  # noqa: E402

NAME = "claude"

# Where this CLI keeps a chain's transcript, spelled out here rather than
# imported: the driver has to find the file without being told where it is, and
# a shim that wrote wherever the driver looked would agree with it by
# construction. The layout is the real one -- the config directory, `projects`,
# the working directory of this process with every separator written as `-`,
# and the chain's own id.
CONFIG_ENV = "CLAUDE_CONFIG_DIR"

# What the seat is seeded with beyond its brief, and it is nothing: no tool, no
# settings file, no MCP server. Each is named with the value it must carry --
# the empty string is what disables a list, and a flag carrying anything else
# has granted the turn something.
LEAN_SEED = (("--tools", ""), ("--setting-sources", ""))


def violations(argv: list[str]) -> list[str]:
    """Every way this invocation departs from the driver's stated contract."""
    faults = []
    if argv[:1] != ["-p"]:
        faults.append(f"the first argument is {argv[:1]}, not ['-p']")
    if flag_value(argv, "--output-format") != "json":
        faults.append("--output-format is not json, so no chain identity comes back")
    if flag_value(argv, "--model") is None:
        faults.append("--model names no model")
    if flag_value(argv, "--effort") is None:
        # Passed on every turn rather than only the cold one: a resumed chain
        # does not inherit it.
        faults.append("--effort is absent, so a resumed chain thinks at whatever it defaults to")
    if flag_value(argv, "--system-prompt") is None:
        faults.append("--system-prompt is absent: the turn carries no standing brief")
    if "--append-system-prompt" in argv:
        # Appended, the brief arrives on top of the CLI's own coding harness --
        # which is the bulk of what the turn is billed, and is house context in
        # a seat that is meant to judge a plan against the world.
        faults.append(
            "--append-system-prompt is present: the brief adds to a harness, is not the whole of one"
        )
    faults += [
        f"{flag} is not passed as {value!r}"
        for flag, value in LEAN_SEED
        if flag_value(argv, flag) != value
    ]
    if "--strict-mcp-config" not in argv:
        faults.append("--strict-mcp-config is absent, so the machine's MCP servers reach the turn")
    if argv and argv[-1].startswith("-"):
        faults.append(f"the last argument is {argv[-1]!r}, not the prompt")
    return faults


def main() -> None:
    argv = sys.argv[1:]
    index = record(
        NAME,
        {
            "argv": argv,
            "cwd": str(Path.cwd()),
            "stdin_devnull": stdin_is_closed(),
            "resume": flag_value(argv, "--resume"),
            "model": flag_value(argv, "--model"),
            "effort": flag_value(argv, "--effort"),
            "brief": flag_value(argv, "--system-prompt"),
            "prompt": argv[-1] if argv else "",
            "violations": violations(argv),
        },
    )
    scripted = turns(NAME)
    if index >= len(scripted):
        raise SystemExit(f"{NAME} shim: no turn {index} is scripted")
    said = printed(scripted[index], flag_value(argv, "--resume"))
    keep(str(said["session_id"]), argv[-1] if argv else "")
    emit(scripted[index], [json.dumps(said)])


def keep(chain: str, prompt: str) -> None:
    """Leave this turn on the chain's transcript, where the CLI leaves it.

    Appended rather than rewritten, because that is what a chain's transcript
    is: one file per conversation that grows by a turn each time. The copy the
    backend keeps is a snapshot of it, so a scenario reading that copy is
    reading the whole conversation and not the last exchange.

    A run with no config directory in the environment writes nothing at all. The
    harness always sets one, and a shim that fell back to the CLI's default
    would be writing into a human's own history the one time the harness did
    not.
    """
    home = os.environ.get(CONFIG_ENV)
    if not home:
        return
    into = Path(home) / "projects" / str(Path.cwd().resolve()).replace("/", "-")
    into.mkdir(parents=True, exist_ok=True)
    with (into / f"{chain}.jsonl").open("a", encoding="utf-8") as file:
        file.write(json.dumps({"type": "user", "text": prompt}) + "\n")


def printed(turn: dict[str, Any], resumed: str | None) -> dict[str, Any]:
    """The object this turn prints."""
    said: dict[str, Any] = {
        "result": turn.get("reply", ""),
        "session_id": turn.get("session_id", resumed or "chain-1"),
    }
    if turn.get("no_message"):
        del said["result"]
    usage = turn.get("usage_input")
    if usage is not None:
        said["usage"] = {"input_tokens": usage, "cache_read_input_tokens": 0}
    return said


if __name__ == "__main__":
    main()
